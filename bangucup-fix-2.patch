diff --git a/services/realtime-gateway/internal/ticket/ticket.go b/services/realtime-gateway/internal/ticket/ticket.go
new file mode 100644
index 0000000..c8d18b7
--- /dev/null
+++ b/services/realtime-gateway/internal/ticket/ticket.go
@@ -0,0 +1,69 @@
+// Package ticket memverifikasi tiket WebSocket yang diterbitkan Laravel
+// (lihat app/Support/WsTicket.php di sisi PHP).
+//
+// Format: base64url(JSON{uid,exp,jti}) "." hex(HMAC-SHA256(secret, base64url(...)))
+package ticket
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"strings"
+	"time"
+)
+
+// Claims adalah isi tiket yang sudah terverifikasi.
+type Claims struct {
+	UserID int64  `json:"uid"`
+	Expiry int64  `json:"exp"`
+	JTI    string `json:"jti"`
+}
+
+var (
+	ErrMalformed = errors.New("ticket: format tidak valid")
+	ErrSignature = errors.New("ticket: tanda tangan tidak valid")
+	ErrExpired   = errors.New("ticket: kedaluwarsa")
+)
+
+// Verify memeriksa tanda tangan dan masa berlaku tiket.
+func Verify(raw, secret string, now time.Time) (*Claims, error) {
+	if secret == "" {
+		return nil, ErrSignature
+	}
+
+	parts := strings.Split(raw, ".")
+	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+		return nil, ErrMalformed
+	}
+	payload, sigHex := parts[0], parts[1]
+
+	gotSig, err := hex.DecodeString(sigHex)
+	if err != nil {
+		return nil, ErrMalformed
+	}
+
+	mac := hmac.New(sha256.New, []byte(secret))
+	mac.Write([]byte(payload))
+	if !hmac.Equal(gotSig, mac.Sum(nil)) { // perbandingan waktu-konstan
+		return nil, ErrSignature
+	}
+
+	body, err := base64.RawURLEncoding.DecodeString(payload)
+	if err != nil {
+		return nil, ErrMalformed
+	}
+
+	var c Claims
+	if err := json.Unmarshal(body, &c); err != nil || c.JTI == "" || c.UserID <= 0 {
+		return nil, ErrMalformed
+	}
+
+	if now.Unix() >= c.Expiry {
+		return nil, ErrExpired
+	}
+
+	return &c, nil
+}
diff --git a/services/realtime-gateway/internal/ticket/ticket_test.go b/services/realtime-gateway/internal/ticket/ticket_test.go
new file mode 100644
index 0000000..44b44ed
--- /dev/null
+++ b/services/realtime-gateway/internal/ticket/ticket_test.go
@@ -0,0 +1,70 @@
+package ticket
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"testing"
+	"time"
+)
+
+const secret = "0123456789abcdef0123456789abcdef"
+
+func sign(payloadJSON, key string) string {
+	p := base64.RawURLEncoding.EncodeToString([]byte(payloadJSON))
+	m := hmac.New(sha256.New, []byte(key))
+	m.Write([]byte(p))
+	return p + "." + hex.EncodeToString(m.Sum(nil))
+}
+
+func TestVerifyValid(t *testing.T) {
+	now := time.Now()
+	tk := sign(fmt.Sprintf(`{"uid":7,"exp":%d,"jti":"abc"}`, now.Add(time.Minute).Unix()), secret)
+	c, err := Verify(tk, secret, now)
+	if err != nil || c.UserID != 7 || c.JTI != "abc" {
+		t.Fatalf("seharusnya valid, got %v %v", c, err)
+	}
+}
+
+func TestVerifyRejects(t *testing.T) {
+	now := time.Now()
+	exp := now.Add(time.Minute).Unix()
+	valid := sign(fmt.Sprintf(`{"uid":7,"exp":%d,"jti":"abc"}`, exp), secret)
+	otherPayload := base64.RawURLEncoding.EncodeToString([]byte(`{"uid":1,"exp":9999999999,"jti":"x"}`))
+
+	cases := map[string]struct {
+		ticket, key string
+		want        error
+	}{
+		"secret salah":        {valid, "kunci-lain-kunci-lain-kunci-lain!!", ErrSignature},
+		"secret kosong":       {valid, "", ErrSignature},
+		"kedaluwarsa":         {sign(fmt.Sprintf(`{"uid":7,"exp":%d,"jti":"abc"}`, now.Add(-time.Second).Unix()), secret), secret, ErrExpired},
+		"payload diganti":     {otherPayload + "." + valid[len(valid)-64:], secret, ErrSignature},
+		"tanpa titik":         {"abc", secret, ErrMalformed},
+		"kosong":              {"", secret, ErrMalformed},
+		"signature bukan hex": {"abc.zzzz", secret, ErrMalformed},
+		"tanpa jti":           {sign(fmt.Sprintf(`{"uid":7,"exp":%d}`, exp), secret), secret, ErrMalformed},
+		"uid nol":             {sign(fmt.Sprintf(`{"uid":0,"exp":%d,"jti":"a"}`, exp), secret), secret, ErrMalformed},
+	}
+	for name, tc := range cases {
+		if _, err := Verify(tc.ticket, tc.key, now); err != tc.want {
+			t.Errorf("%s: want %v, got %v", name, tc.want, err)
+		}
+	}
+}
+
+// Interop: tiket dibuat oleh PHP (WsTicket::make) dan diverifikasi di Go.
+// Dijalankan bila env PHP_TICKET diisi.
+func TestVerifyTicketFromPHP(t *testing.T) {
+	tk := os.Getenv("PHP_TICKET")
+	if tk == "" {
+		t.Skip("PHP_TICKET tidak diisi")
+	}
+	c, err := Verify(tk, secret, time.Now())
+	if err != nil || c.UserID != 42 {
+		t.Fatalf("tiket dari PHP harus valid: %v %v", c, err)
+	}
+}
