+                GROUP BY 1, 2 HAVING COUNT(*) > 1',
+            'Port ODP dipakai lebih dari satu langganan aktif' => "SELECT odp_id, port_number FROM subscriptions
+                WHERE odp_id IS NOT NULL AND port_number IS NOT NULL AND status <> 'terminated'
+                GROUP BY 1, 2 HAVING COUNT(*) > 1",
