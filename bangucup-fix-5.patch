diff --git a/phpunit.pgsql.xml b/phpunit.pgsql.xml
new file mode 100644
index 0000000..865b5aa
--- /dev/null
+++ b/phpunit.pgsql.xml
@@ -0,0 +1,46 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+    Setelan test untuk Bangucup (PostgreSQL). Salin menjadi phpunit.xml:
+        copy /Y phpunit.pgsql.xml phpunit.xml
+
+    Atribut force="true" WAJIB untuk nilai yang bisa tertimpa environment container
+    (DB_DATABASE, cache, dst.). Tanpa itu, test bisa berjalan di database development
+    dan RefreshDatabase akan menghapusnya. tests/ApiTestCase.php menolak berjalan bila
+    nama database tidak berakhiran "_test".
+-->
+<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
+         bootstrap="vendor/autoload.php"
+         colors="true"
+>
+    <testsuites>
+        <testsuite name="Unit">
+            <directory>tests/Unit</directory>
+        </testsuite>
+        <testsuite name="Feature">
+            <directory>tests/Feature</directory>
+        </testsuite>
+    </testsuites>
+    <source>
+        <include>
+            <directory>app</directory>
+        </include>
+    </source>
+    <php>
+        <env name="APP_ENV" value="testing" force="true"/>
+        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
+        <env name="BCRYPT_ROUNDS" value="4"/>
+        <env name="BROADCAST_CONNECTION" value="null"/>
+        <env name="CACHE_STORE" value="array" force="true"/>
+        <env name="DB_CONNECTION" value="pgsql" force="true"/>
+        <env name="DB_DATABASE" value="bangucup_test" force="true"/>
+        <env name="DB_URL" value="" force="true"/>
+        <env name="MAIL_MAILER" value="array"/>
+        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
+        <env name="SESSION_DRIVER" value="array" force="true"/>
+        <env name="WS_TICKET_SECRET" value="rahasia-test-rahasia-test-rahasia-test-1234" force="true"/>
+        <env name="PULSE_ENABLED" value="false"/>
+        <env name="TELESCOPE_ENABLED" value="false"/>
+        <env name="NIGHTWATCH_ENABLED" value="false"/>
+    </php>
+</phpunit>
diff --git a/tests/ApiTestCase.php b/tests/ApiTestCase.php
new file mode 100644
index 0000000..c98851d
--- /dev/null
+++ b/tests/ApiTestCase.php
@@ -0,0 +1,176 @@
+<?php
+
+namespace Tests;
+
+use App\Models\Customer;
+use App\Models\Invoice;
+use App\Models\MikrotikRouter;
+use App\Models\Odp;
+use App\Models\Package;
+use App\Models\Subscription;
+use App\Models\User;
+use Database\Seeders\RolePermissionSeeder;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use Spatie\Permission\PermissionRegistrar;
+
+/**
+ * Dasar semua test API Bangucup.
+ *
+ * Memakai PostgreSQL sungguhan (migration memakai CHECK dan indeks parsial, jadi SQLite tidak cukup)
+ * dan menolak berjalan di database yang namanya tidak berakhiran "_test".
+ */
+abstract class ApiTestCase extends TestCase
+{
+    use RefreshDatabase;
+
+    protected const ROUTER_SECRET = 'rahasia-router-123';
+
+    protected function setUp(): void
+    {
+        // Pengaman 1: cek variabel environment SEBELUM aplikasi menyala dan migrate:fresh berjalan.
+        $database = (string) ($_ENV['DB_DATABASE'] ?? $_SERVER['DB_DATABASE'] ?? getenv('DB_DATABASE') ?: '');
+
+        if (! str_ends_with($database, '_test')) {
+            throw new \RuntimeException(
+                "Test DIHENTIKAN: DB_DATABASE='{$database}' bukan database test (harus berakhiran _test). "
+                .'Salin phpunit.pgsql.xml menjadi phpunit.xml dan buat database bangucup_test.'
+            );
+        }
+
+        parent::setUp();
+
+        $this->seed(RolePermissionSeeder::class);
+        app(PermissionRegistrar::class)->forgetCachedPermissions();
+    }
+
+    /** Pengaman 2: cek koneksi yang benar-benar dipakai sebelum database dihapus. */
+    protected function beforeRefreshingDatabase()
+    {
+        $name = (string) DB::connection()->getDatabaseName();
+
+        if (! str_ends_with($name, '_test')) {
+            throw new \RuntimeException("Test DIHENTIKAN: koneksi database '{$name}' bukan database test.");
+        }
+    }
+
+    // ── Autentikasi ──────────────────────────────────────────────────────────
+
+    protected function userWithRole(string $role, array $attributes = []): User
+    {
+        $user = User::create($attributes + [
+            'name'     => ucfirst($role).' Test',
+            'email'    => $role.'-'.Str::lower(Str::random(6)).'@test.local',
+            'password' => 'Rahasia12345',
+        ]);
+
+        $user->assignRole($role);
+
+        return $user;
+    }
+
+    /** Pakai token Sanctum asli (bukan mock) agar ability dan kedaluwarsa teruji apa adanya. */
+    protected function asUser(User $user, array $abilities = ['*']): static
+    {
+        $this->app['auth']->forgetGuards();
+
+        return $this->withHeaders([
+            'Authorization' => 'Bearer '.$user->createToken('test', $abilities)->plainTextToken,
+        ]);
+    }
+
+    protected function asRole(string $role): User
+    {
+        $user = $this->userWithRole($role);
+        $this->asUser($user);
+
+        return $user;
+    }
+
+    // ── Data uji ─────────────────────────────────────────────────────────────
+
+    protected function makeCustomer(array $o = []): Customer
+    {
+        return Customer::create($o + [
+            'name'    => 'Budi Test',
+            'phone'   => '081234567890',
+            'address' => 'Jl. Contoh No. 1',
+            'status'  => 'active',
+        ]);
+    }
+
+    protected function makePackage(array $o = []): Package
+    {
+        return Package::create($o + [
+            'name'                  => 'Paket 10 Mbps',
+            'speed_mbps'            => 10,
+            'price'                 => 150000,
+            'mikrotik_profile_name' => '10M',
+        ]);
+    }
+
+    protected function makeRouter(array $o = []): MikrotikRouter
+    {
+        return MikrotikRouter::create($o + [
+            'name'     => 'Router Test',
+            'host'     => '10.255.255.1',
+            'api_port' => 8728,
+            'username' => 'api',
+            'password' => self::ROUTER_SECRET,
+        ]);
+    }
+
+    protected function makeOdp(int $ports = 8): Odp
+    {
+        return Odp::create(['name' => 'ODP-'.Str::upper(Str::random(4)), 'total_ports' => $ports]);
+    }
+
+    protected function makeSubscription(?Customer $customer = null, array $o = []): Subscription
+    {
+        $customer ??= $this->makeCustomer();
+
+        return Subscription::create($o + [
+            'customer_id'      => $customer->id,
+            'package_id'       => $this->makePackage()->id,
+            'pppoe_username'   => 'user'.Str::lower(Str::random(8)),
+            'pppoe_password'   => 'pw-'.Str::random(6),
+            'billing_due_date' => 1,
+            'status'           => 'active',
+            'started_at'       => today()->toDateString(),
+        ]);
+    }
+
+    protected function makeInvoice(Subscription $subscription, array $o = []): Invoice
+    {
+        return Invoice::create($o + [
+            'customer_id'     => $subscription->customer_id,
+            'subscription_id' => $subscription->id,
+            'type'            => 'monthly',
+            'amount'          => 150000,
+            'discount_amount' => 0,
+            'due_date'        => today()->addDays(10)->toDateString(),
+            'status'          => 'unpaid',
+        ]);
+    }
+
+    // ── Pembantu assertion ───────────────────────────────────────────────────
+
+    /**
+     * Pastikan database menolak operasi ini. Dibungkus DB::transaction (savepoint) supaya
+     * kegagalan satu statement tidak menggagalkan transaksi test di PostgreSQL.
+     */
+    protected function assertDatabaseRejects(callable $operation, string $message): void
+    {
+        try {
+            DB::transaction($operation);
+        } catch (QueryException) {
+            $this->addToAssertionCount(1);
+
+            return;
+        }
+
+        $this->fail($message);
+    }
+}
diff --git a/tests/Feature/AuthorizationTest.php b/tests/Feature/AuthorizationTest.php
new file mode 100644
index 0000000..4796b76
--- /dev/null
+++ b/tests/Feature/AuthorizationTest.php
@@ -0,0 +1,170 @@
+<?php
+
+namespace Tests\Feature;
+
+use Laravel\Sanctum\PersonalAccessToken;
+use Tests\ApiTestCase;
+
+class AuthorizationTest extends ApiTestCase
+{
+    public function test_tanpa_login_semua_endpoint_ditolak(): void
+    {
+        $this->getJson('/api/customers')->assertUnauthorized();
+        $this->getJson('/api/users')->assertUnauthorized();
+        $this->getJson('/api/internal/routers')->assertUnauthorized();
+    }
+
+    public function test_teknisi_tidak_bisa_membuat_user(): void
+    {
+        $this->asRole('teknisi');
+
+        $this->postJson('/api/users', [
+            'name' => 'Penyusup', 'email' => 'x@test.local', 'password' => 'Rahasia12345',
+        ])->assertForbidden();
+    }
+
+    public function test_teknisi_tidak_bisa_naik_jabatan_jadi_super_admin(): void
+    {
+        $teknisi = $this->asRole('teknisi');
+
+        $this->postJson("/api/users/{$teknisi->id}/roles", ['roles' => ['super_admin']])->assertForbidden();
+
+        $this->assertFalse($teknisi->fresh()->hasRole('super_admin'));
+    }
+
+    public function test_teknisi_tidak_bisa_melihat_data_keuangan_tapi_bisa_tiket(): void
+    {
+        $this->asRole('teknisi');
+
+        $this->getJson('/api/invoices')->assertForbidden();
+        $this->getJson('/api/payments')->assertForbidden();
+        $this->getJson('/api/tickets')->assertOk();
+    }
+
+    public function test_staff_tidak_bisa_menghapus_pelanggan_atau_mengelola_router(): void
+    {
+        $this->asRole('staff');
+        $customer = $this->makeCustomer();
+
+        $this->deleteJson("/api/customers/{$customer->id}")->assertForbidden();
+        $this->getJson('/api/routers')->assertForbidden();
+        $this->assertDatabaseHas('customers', ['id' => $customer->id]);
+    }
+
+    public function test_staff_bisa_membaca_paket_dan_odp_untuk_form(): void
+    {
+        $this->asRole('staff');
+
+        $this->getJson('/api/packages')->assertOk();
+        $this->getJson('/api/odps')->assertOk();
+    }
+
+    public function test_admin_tidak_bisa_menetapkan_role_saat_membuat_user(): void
+    {
+        $this->asRole('admin');
+
+        $this->postJson('/api/users', [
+            'name' => 'Baru', 'email' => 'baru@test.local', 'password' => 'Rahasia12345', 'roles' => ['staff'],
+        ])->assertForbidden();
+
+        $this->assertDatabaseMissing('users', ['email' => 'baru@test.local']);
+    }
+
+    public function test_admin_tidak_bisa_mengubah_akun_super_admin(): void
+    {
+        $superAdmin = $this->userWithRole('super_admin');
+        $this->asRole('admin');
+
+        $this->putJson("/api/users/{$superAdmin->id}", ['name' => 'Diganti'])->assertForbidden();
+        $this->deleteJson("/api/users/{$superAdmin->id}")->assertForbidden();
+
+        $this->assertNotSame('Diganti', $superAdmin->fresh()->name);
+    }
+
+    public function test_super_admin_bisa_membuat_user_dengan_role(): void
+    {
+        $this->asRole('super_admin');
+
+        $this->postJson('/api/users', [
+            'name' => 'Staf Baru', 'email' => 'staf@test.local', 'password' => 'Rahasia12345', 'roles' => ['staff'],
+        ])->assertCreated();
+
+        $this->assertTrue(\App\Models\User::where('email', 'staf@test.local')->firstOrFail()->hasRole('staff'));
+    }
+
+    public function test_super_admin_terakhir_tidak_bisa_dicabut_rolenya(): void
+    {
+        $superAdmin = $this->asRole('super_admin');
+
+        $this->postJson("/api/users/{$superAdmin->id}/roles", ['roles' => ['staff']])->assertStatus(422);
+
+        $this->assertTrue($superAdmin->fresh()->hasRole('super_admin'));
+    }
+
+    public function test_login_dibatasi_lima_percobaan_per_menit(): void
+    {
+        for ($i = 0; $i < 5; $i++) {
+            $this->postJson('/api/auth/login', ['email' => 'tidak@ada.test', 'password' => 'salah'])
+                ->assertUnauthorized();
+        }
+
+        $this->postJson('/api/auth/login', ['email' => 'tidak@ada.test', 'password' => 'salah'])
+            ->assertStatus(429);
+    }
+
+    public function test_token_login_memiliki_masa_berlaku(): void
+    {
+        $user = $this->userWithRole('staff', ['email' => 'staf@test.local']);
+
+        $this->postJson('/api/auth/login', ['email' => $user->email, 'password' => 'Rahasia12345'])
+            ->assertOk();
+
+        $token = PersonalAccessToken::where('tokenable_id', $user->id)->latest('id')->firstOrFail();
+
+        $this->assertNotNull($token->expires_at, 'Token login harus punya expires_at.');
+        $this->assertTrue($token->expires_at->isFuture());
+    }
+
+    public function test_password_router_tidak_pernah_ada_di_respons_api_biasa(): void
+    {
+        $router = $this->makeRouter();
+        $this->asRole('super_admin');
+
+        $this->getJson('/api/routers')->assertOk()
+            ->assertDontSee(self::ROUTER_SECRET);
+
+        $this->getJson("/api/routers/{$router->id}")->assertOk()
+            ->assertDontSee(self::ROUTER_SECRET);
+    }
+
+    public function test_endpoint_internal_hanya_menerima_token_collector(): void
+    {
+        $this->makeRouter();
+
+        // Token login biasa (ability *) milik super_admin ditolak.
+        $superAdmin = $this->userWithRole('super_admin');
+        $this->asUser($superAdmin)->getJson('/api/internal/routers')->assertForbidden();
+
+        // Token dengan ability routers:collect diterima dan membawa password untuk collector.
+        $collector = \App\Models\User::create([
+            'name' => 'Collector', 'email' => 'collector@test.local', 'password' => 'Rahasia12345',
+        ]);
+
+        $this->asUser($collector, ['routers:collect'])
+            ->getJson('/api/internal/routers')
+            ->assertOk()
+            ->assertSee(self::ROUTER_SECRET);
+    }
+
+    public function test_token_collector_tidak_bisa_memakai_endpoint_lain(): void
+    {
+        $collector = \App\Models\User::create([
+            'name' => 'Collector', 'email' => 'collector@test.local', 'password' => 'Rahasia12345',
+        ]);
+
+        $this->asUser($collector, ['routers:collect']);
+
+        $this->getJson('/api/customers')->assertForbidden();
+        $this->getJson('/api/routers')->assertForbidden();
+    }
+}
diff --git a/tests/Feature/AutoIsolirTest.php b/tests/Feature/AutoIsolirTest.php
new file mode 100644
index 0000000..d695ce2
--- /dev/null
+++ b/tests/Feature/AutoIsolirTest.php
@@ -0,0 +1,227 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Invoice;
+use App\Models\IsolirLog;
+use App\Models\MikrotikRouter;
+use App\Models\Subscription;
+use App\Services\MikrotikService;
+use Mockery\MockInterface;
+use Tests\ApiTestCase;
+
+class AutoIsolirTest extends ApiTestCase
+{
+    private MikrotikRouter $router;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->router = $this->makeRouter();
+    }
+
+    /** Buat $count langganan aktif dengan tagihan overdue 10 hari (melewati masa tenggang 3 hari). */
+    private function overdueSubscriptions(int $count): void
+    {
+        for ($i = 0; $i < $count; $i++) {
+            $subscription = $this->makeSubscription(null, ['mikrotik_router_id' => $this->router->id]);
+            $this->makeInvoice($subscription, [
+                'status'   => 'overdue',
+                'due_date' => today()->subDays(10)->toDateString(),
+            ]);
+        }
+    }
+
+    private function isolirCount(): int
+    {
+        return Subscription::where('status', 'isolir')->count();
+    }
+
+    public function test_dry_run_tidak_menyentuh_router_maupun_data(): void
+    {
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldNotReceive('testConnection');
+            $mock->shouldNotReceive('isolir');
+        });
+        $this->overdueSubscriptions(3);
+
+        $this->artisan('billing:auto-isolir', ['--dry-run' => true])->assertExitCode(0);
+
+        $this->assertSame(0, $this->isolirCount());
+        $this->assertSame(0, IsolirLog::count());
+    }
+
+    public function test_semua_diisolir_dan_tercatat_bila_di_bawah_batas(): void
+    {
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldReceive('testConnection')->once()->andReturn(true);
+            $mock->shouldReceive('isolir')->twice()->andReturn(true);
+        });
+        $this->overdueSubscriptions(2);
+
+        $this->artisan('billing:auto-isolir')->assertExitCode(0);
+
+        $this->assertSame(2, $this->isolirCount());
+        $this->assertSame(2, IsolirLog::where('action', 'isolir')->where('triggered_by', 'system')->count());
+    }
+
+    public function test_di_atas_batas_pengaman_seluruh_eksekusi_dibatalkan(): void
+    {
+        config(['billing.isolir_max_per_run' => 2]);
+
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldNotReceive('testConnection');
+            $mock->shouldNotReceive('isolir');
+        });
+        $this->overdueSubscriptions(3);
+
+        $this->artisan('billing:auto-isolir')->assertExitCode(1);
+
+        $this->assertSame(0, $this->isolirCount());
+        $this->assertSame(0, IsolirLog::count());
+    }
+
+    public function test_limit_mengisolir_sebagian_walau_di_atas_batas(): void
+    {
+        config(['billing.isolir_max_per_run' => 2]);
+
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldReceive('testConnection')->once()->andReturn(true);
+            $mock->shouldReceive('isolir')->once()->andReturn(true);
+        });
+        $this->overdueSubscriptions(3);
+
+        $this->artisan('billing:auto-isolir', ['--limit' => 1])->assertExitCode(0);
+
+        $this->assertSame(1, $this->isolirCount());
+        $this->assertSame(1, IsolirLog::count());
+    }
+
+    public function test_force_melewati_batas_pengaman(): void
+    {
+        config(['billing.isolir_max_per_run' => 1]);
+
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldReceive('testConnection')->once()->andReturn(true);
+            $mock->shouldReceive('isolir')->twice()->andReturn(true);
+        });
+        $this->overdueSubscriptions(2);
+
+        $this->artisan('billing:auto-isolir', ['--force' => true])->assertExitCode(0);
+
+        $this->assertSame(2, $this->isolirCount());
+    }
+
+    public function test_limit_tidak_valid_ditolak(): void
+    {
+        $this->overdueSubscriptions(1);
+
+        $this->artisan('billing:auto-isolir', ['--limit' => 0])->assertExitCode(1);
+
+        $this->assertSame(0, $this->isolirCount());
+    }
+
+    public function test_router_tidak_terjangkau_dilewati_tanpa_mengubah_data(): void
+    {
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldReceive('testConnection')->once()->andReturn(false);
+            $mock->shouldNotReceive('isolir');
+        });
+        $this->overdueSubscriptions(3);
+
+        $this->artisan('billing:auto-isolir')->assertExitCode(0);
+
+        $this->assertSame(0, $this->isolirCount());
+        $this->assertSame(0, IsolirLog::count());
+    }
+
+    public function test_gagal_di_mikrotik_mengembalikan_status_gagal_dan_data_tetap_aktif(): void
+    {
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldReceive('testConnection')->once()->andReturn(true);
+            $mock->shouldReceive('isolir')->once()->andReturn(false);
+        });
+        $this->overdueSubscriptions(1);
+
+        $this->artisan('billing:auto-isolir')->assertExitCode(1);
+
+        $this->assertSame(0, $this->isolirCount());
+        $this->assertSame(0, IsolirLog::count());
+    }
+
+    public function test_pemutus_menghentikan_router_yang_gagal_berturut_turut(): void
+    {
+        // 3 kegagalan beruntun pada satu router -> sisa langganan router itu dilewati.
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldReceive('testConnection')->once()->andReturn(true);
+            $mock->shouldReceive('isolir')->times(3)->andReturn(false);
+        });
+        $this->overdueSubscriptions(6);
+
+        $this->artisan('billing:auto-isolir', ['--force' => true])->assertExitCode(1);
+
+        $this->assertSame(0, $this->isolirCount());
+    }
+
+    public function test_pelanggan_yang_baru_lunas_saat_proses_berjalan_dilewati(): void
+    {
+        // Simulasi: pelanggan membayar setelah daftar kandidat diambil, sebelum isolir dieksekusi.
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldReceive('testConnection')->once()->andReturnUsing(function () {
+                Invoice::query()->update(['status' => 'paid', 'paid_at' => now()]);
+
+                return true;
+            });
+            $mock->shouldNotReceive('isolir');
+        });
+        $this->overdueSubscriptions(2);
+
+        $this->artisan('billing:auto-isolir')->assertExitCode(0);
+
+        $this->assertSame(0, $this->isolirCount());
+    }
+
+    public function test_hanya_langganan_aktif_dengan_overdue_lewat_masa_tenggang_yang_dipilih(): void
+    {
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldNotReceive('testConnection');
+            $mock->shouldNotReceive('isolir');
+        });
+
+        // a) Tagihan belum overdue (unpaid)
+        $a = $this->makeSubscription(null, ['mikrotik_router_id' => $this->router->id]);
+        $this->makeInvoice($a, ['status' => 'unpaid', 'due_date' => today()->subDays(10)->toDateString()]);
+
+        // b) Overdue tetapi masih dalam masa tenggang (kemarin)
+        $b = $this->makeSubscription(null, ['mikrotik_router_id' => $this->router->id]);
+        $this->makeInvoice($b, ['status' => 'overdue', 'due_date' => today()->subDay()->toDateString()]);
+
+        // c) Sudah terisolir
+        $c = $this->makeSubscription(null, ['mikrotik_router_id' => $this->router->id, 'status' => 'isolir']);
+        $this->makeInvoice($c, ['status' => 'overdue', 'due_date' => today()->subDays(10)->toDateString()]);
+
+        // d) Sudah berhenti berlangganan
+        $d = $this->makeSubscription(null, ['mikrotik_router_id' => $this->router->id, 'status' => 'terminated']);
+        $this->makeInvoice($d, ['status' => 'overdue', 'due_date' => today()->subDays(10)->toDateString()]);
+
+        $this->artisan('billing:auto-isolir')->assertExitCode(0);
+
+        $this->assertSame(0, IsolirLog::count());
+    }
+
+    public function test_langganan_tanpa_router_dilewati(): void
+    {
+        $this->mock(MikrotikService::class, function (MockInterface $mock) {
+            $mock->shouldNotReceive('testConnection');
+            $mock->shouldNotReceive('isolir');
+        });
+
+        $subscription = $this->makeSubscription();
+        $this->makeInvoice($subscription, ['status' => 'overdue', 'due_date' => today()->subDays(10)->toDateString()]);
+
+        $this->artisan('billing:auto-isolir')->assertExitCode(0);
+
+        $this->assertSame('active', $subscription->fresh()->status);
+    }
+}
