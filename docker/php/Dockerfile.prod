# ══════════════════════════════════════════════════════════════════
# STAGE 1 — node-builder: compile frontend assets (JS + CSS)
# ══════════════════════════════════════════════════════════════════
FROM node:22-alpine AS node-builder

WORKDIR /app

# Copy dependency manifest dulu — layer ini di-cache selama package.json
# tidak berubah, sehingga npm ci lebih cepat pada build ulang.
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Copy sumber dan build untuk production
# Tailwind v4 pakai vite plugin — tidak ada tailwind.config.js terpisah
COPY resources/ resources/
COPY vite.config.js ./
# public/ diperlukan Vite untuk menulis manifest ke public/build/
COPY public/ public/
RUN npm run build


# ══════════════════════════════════════════════════════════════════
# STAGE 2 — composer-builder: install PHP dependencies tanpa devtools
# ══════════════════════════════════════════════════════════════════
FROM composer:2 AS composer-builder

WORKDIR /app

COPY composer.json composer.lock ./
# --no-dev: skip phpunit, faker, collision, dll
# --no-scripts: skip post-install hooks (autoload:dump dijalankan manual)
# --no-autoloader: generate autoloader setelah copy source
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --no-interaction \
    --ignore-platform-reqs

# Copy source PHP lalu generate optimized autoloader
COPY app/        app/
COPY bootstrap/  bootstrap/
COPY config/     config/
COPY database/   database/
COPY routes/     routes/
COPY storage/    storage/
COPY artisan     artisan

RUN composer dump-autoload --optimize --no-dev --ignore-platform-reqs


# ══════════════════════════════════════════════════════════════════
# STAGE 3 — runtime: image final yang berjalan di production
# ══════════════════════════════════════════════════════════════════
FROM php:8.4-fpm AS runtime

# ── System dependencies ──────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq-dev \
        libzip-dev \
        libpng-dev \
        libonig-dev \
        libxml2-dev \
        libicu-dev \
        unzip \
        curl \
    && docker-php-ext-configure intl \
    && docker-php-ext-install \
        pdo \
        pdo_pgsql \
        pgsql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
        opcache \
        sockets \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── OPcache production config ────────────────────────────────────
RUN { \
    echo "opcache.enable=1"; \
    echo "opcache.memory_consumption=128"; \
    echo "opcache.interned_strings_buffer=16"; \
    echo "opcache.max_accelerated_files=10000"; \
    echo "opcache.validate_timestamps=0"; \
    echo "opcache.save_comments=1"; \
    echo "opcache.fast_shutdown=1"; \
} > /usr/local/etc/php/conf.d/opcache-prod.ini

# ── PHP production settings ──────────────────────────────────────
RUN { \
    echo "upload_max_filesize=100M"; \
    echo "post_max_size=100M"; \
    echo "memory_limit=256M"; \
    echo "max_execution_time=60"; \
    echo "expose_php=Off"; \
    echo "display_errors=Off"; \
    echo "log_errors=On"; \
    echo "error_log=/var/www/html/storage/logs/php-error.log"; \
} > /usr/local/etc/php/conf.d/prod.ini

WORKDIR /var/www/html

# ── Copy artifacts dari stage sebelumnya ─────────────────────────
# Vendor PHP (tanpa dev deps, autoloader sudah dioptimasi)
COPY --from=composer-builder /app/vendor          vendor/
COPY --from=composer-builder /app/app             app/
COPY --from=composer-builder /app/bootstrap       bootstrap/
COPY --from=composer-builder /app/config          config/
COPY --from=composer-builder /app/database        database/
COPY --from=composer-builder /app/routes          routes/
COPY --from=composer-builder /app/storage         storage/
COPY --from=composer-builder /app/artisan         artisan
COPY --from=composer-builder /app/composer.json   composer.json

# Frontend assets hasil build Vite
COPY --from=node-builder /app/public              public/

# Sumber blade views (tidak ada resources/lang di project ini)
COPY resources/views  resources/views

# ── Permissions ──────────────────────────────────────────────────
RUN chown -R www-data:www-data \
        storage \
        bootstrap/cache \
        public \
    && chmod -R 755 storage bootstrap/cache

EXPOSE 9000

CMD ["php-fpm"]
