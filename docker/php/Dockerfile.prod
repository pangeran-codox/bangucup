# ══════════════════════════════════════════════════════════════════
# STAGE 1 — node-builder: build React SPA (frontend/admin/)
# ══════════════════════════════════════════════════════════════════
FROM node:22-alpine AS node-builder

WORKDIR /app

# Install deps dulu (di-cache selama package.json tidak berubah)
COPY frontend/admin/package.json frontend/admin/package-lock.json ./
RUN npm ci --ignore-scripts

# Copy source dan build
COPY frontend/admin/ ./
RUN npm run build
# Output: /app/dist/


# ══════════════════════════════════════════════════════════════════
# STAGE 2 — composer-builder: install PHP dependencies
# ══════════════════════════════════════════════════════════════════
FROM composer:2 AS composer-builder

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --no-interaction \
    --ignore-platform-reqs

COPY app/        app/
COPY bootstrap/  bootstrap/
COPY config/     config/
COPY database/   database/
COPY routes/     routes/
COPY storage/    storage/
COPY artisan     artisan

RUN composer dump-autoload --optimize --no-dev --ignore-platform-reqs


# ══════════════════════════════════════════════════════════════════
# STAGE 3 — runtime: PHP-FPM production image
# ══════════════════════════════════════════════════════════════════
FROM php:8.4-fpm AS runtime

# ── System dependencies ──────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq-dev \
        libzip-dev \
        libpng-dev \
        libonig-dev \
        libxml2-dev \
        libicu-dev \
        unzip \
        curl \
    && docker-php-ext-configure intl \
    && docker-php-ext-install \
        pdo \
        pdo_pgsql \
        pgsql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
        opcache \
        sockets \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── OPcache production config ────────────────────────────────────
RUN { \
    echo "opcache.enable=1"; \
    echo "opcache.memory_consumption=128"; \
    echo "opcache.interned_strings_buffer=16"; \
    echo "opcache.max_accelerated_files=10000"; \
    echo "opcache.validate_timestamps=0"; \
    echo "opcache.save_comments=1"; \
    echo "opcache.fast_shutdown=1"; \
} > /usr/local/etc/php/conf.d/opcache-prod.ini

# ── PHP production settings ──────────────────────────────────────
RUN { \
    echo "upload_max_filesize=100M"; \
    echo "post_max_size=100M"; \
    echo "memory_limit=256M"; \
    echo "max_execution_time=60"; \
    echo "expose_php=Off"; \
    echo "display_errors=Off"; \
    echo "log_errors=On"; \
    echo "error_log=/var/www/html/storage/logs/php-error.log"; \
} > /usr/local/etc/php/conf.d/prod.ini

WORKDIR /var/www/html

# ── Copy artifacts ────────────────────────────────────────────────
COPY --from=composer-builder /app/vendor          vendor/
COPY --from=composer-builder /app/app             app/
COPY --from=composer-builder /app/bootstrap       bootstrap/
COPY --from=composer-builder /app/config          config/
COPY --from=composer-builder /app/database        database/
COPY --from=composer-builder /app/routes          routes/
COPY --from=composer-builder /app/storage         storage/
COPY --from=composer-builder /app/artisan         artisan
COPY --from=composer-builder /app/composer.json   composer.json

# Laravel public dir (favicon, robots.txt, index.php, dll)
COPY public/ public/

# React SPA build output → public/
COPY --from=node-builder /app/dist/ public/

# Blade views — dibutuhkan php artisan view:cache
COPY resources/ resources/

# ── Permissions ──────────────────────────────────────────────────
RUN chown -R www-data:www-data \
        storage \
        bootstrap/cache \
        public \
    && chmod -R 755 storage bootstrap/cache

EXPOSE 9000
CMD ["php-fpm"]
